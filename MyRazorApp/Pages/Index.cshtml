@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-4">
            <h4>@(Model.EditId.HasValue ? "Edit Class" : "Add New Class")</h4>
            <form method="post">
                <input type="hidden" asp-for="EditId" />

                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input asp-for="NewClass.StudentCount" type="number" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(Model.EditId.HasValue ? "Update Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Table Column -->
        <div class="col-md-8">
            <h4>Class List</h4>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classItem in Model.Classes)
                    {
                        <tr>
                            <td>@classItem.Id</td>
                            <td>@classItem.ClassName</td>
                            <td>@classItem.StudentCount</td>
                            <td>@classItem.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@classItem.Id" />
                                    <button type="submit" asp-page-handler="Edit"
                                        class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Validation Scripts -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script
        src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
