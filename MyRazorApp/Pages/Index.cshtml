@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<style>
    body {
        background-color: #f8f9fa;
    }

    h2 {
        color: #007bff;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-warning:hover, .btn-danger:hover {
        opacity: 0.8;
    }

    .edit-icon:before {
        content: "\270F";
        margin-right: 5px;
    }

    .delete-icon:before {
        content: "\1F5D1";
        margin-right: 5px;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h2>Add/Edit Class</h2>
            <form method="post">
                <input type="hidden" asp-for="ClassInformation.Id" />

                <div class="mb-3">
                    <label asp-for="ClassInformation.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassInformation.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInformation.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="ClassInformation.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInformation.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInformation.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>

        <div class="col-md-6">
            <h2>Class List</h2>

            <!-- Search Bar -->
            <form method="get" class="mb-3">
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search by Class Name" class="form-control" />
                <button type="submit" class="btn btn-secondary mt-2">Filter</button>
            </form>

            <table class="table">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClasses)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning"> <span class="edit-icon"></span>Edit</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"> <span class="delete-icon"></span>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
