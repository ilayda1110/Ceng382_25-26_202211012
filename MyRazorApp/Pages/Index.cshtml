@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<style>
    /* Now, customize the site. Add colors for the body, header and symbols (trashcan for delete & pencil for edit) */
    body {
        background-color: #f8f9fa; /* Light gray background */
    }

    h2 {
        color: #007bff; /* Blue header text */
    }

    .btn-warning {
        background-color: #ffc107; /* Yellow edit button */
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545; /* Red delete button */
        border-color: #dc3545;
    }

    .btn-warning:hover, .btn-danger:hover{
        opacity: 0.8;
    }

    .edit-icon:before {
        content: "\270F"; /* Pencil symbol */
        margin-right: 5px;
    }

    .delete-icon:before {
        content: "\1F5D1"; /* Trashcan symbol */
        margin-right: 5px;
    }

</style>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h2>Add/Edit Class</h2>
            <form method="post">
                <input type="hidden" asp-for="ClassInformation.Id" />

                <div class="mb-3">
                    <label asp-for="ClassInformation.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassInformation.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInformation.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="ClassInformation.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInformation.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInformation.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>

        <div class="col-md-6">
            <h2>Class List</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassInformations)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning"> <span class="edit-icon"></span>Edit</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"> <span class="delete-icon"></span>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>