@page
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Class Information";
    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<input type="hidden" id="__RequestVerificationToken" name="__RequestVerificationToken" value="@token" />

<style>
    body {
        background-color: #f8f9fa;
    }

    h2 {
        color: #007bff;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-warning:hover, .btn-danger:hover, .btn-info:hover {
        opacity: 0.8;
    }

    .edit-icon:before {
        content: "\270F";
        margin-right: 5px;
    }

    .delete-icon:before {
        content: "\1F5D1";
        margin-right: 5px;
    }

    .export-icon:before {
        content: "\1F4BE";
        margin-right: 5px;
    }

    .column-selector {
        cursor: pointer;
        user-select: none;
    }

    .column-selected {
        background-color: #d4edda;
    }

    .action-column {
        width: 200px;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h2>Add/Edit Class</h2>
            <form method="post">
                <input type="hidden" asp-for="ClassInformation.Id" />

                <div class="mb-3">
                    <label asp-for="ClassInformation.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassInformation.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInformation.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="ClassInformation.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInformation.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInformation.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInformation.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>

        <div class="col-md-6">
            <h2>Class List</h2>

            <!-- Search Bar -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search by Class Name" class="form-control" />
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </div>
            </form>

            <!-- Export Buttons -->
            <div class="mb-3 btn-group">
                <button id="exportAllBtn" class="btn btn-info">
                    <span class="export-icon"></span>Export All
                </button>
                <button id="exportFilteredBtn" class="btn btn-info">
                    <span class="export-icon"></span>Export Filtered
                </button>
            </div>

            <table class="table table-striped table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th class="column-selector" data-column="ClassName">Class Name</th>
                        <th class="column-selector" data-column="StudentCount">Student Count</th>
                        <th class="column-selector" data-column="Description">Description</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClasses)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <span class="edit-icon"></span>Edit
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Are you sure you want to delete this class?')">
                                        <span class="delete-icon"></span>Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var selectedColumns = [];
            
            // Column selection
            $('.column-selector').click(function() {
                $(this).toggleClass('column-selected');
                var columnName = $(this).data('column');
                
                if ($(this).hasClass('column-selected')) {
                    if (!selectedColumns.includes(columnName)) {
                        selectedColumns.push(columnName);
                    }
                } else {
                    selectedColumns = selectedColumns.filter(col => col !== columnName);
                }
            });
            
            // Export buttons
            $('#exportAllBtn, #exportFilteredBtn').click(function(e) {
                e.preventDefault();
                var isFiltered = $(this).attr('id') === 'exportFilteredBtn';
                exportData(isFiltered);
            });
            
            function exportData(filteredOnly) {
    $.ajax({
        url: '?handler=Export',
        type: 'POST',
        data: {
            filteredOnly: filteredOnly,
            selectedColumns: selectedColumns,
            searchTerm: $('input[name="SearchTerm"]').val(),
            pageNumber: @Model.PageNumber
        },
        headers: {
            RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(data) {
            // Create download
            var blob = new Blob([data.json], { type: 'application/json' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = data.fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            
            // Show success message
            alert('File has been saved to the Log folder and downloaded.');
        },
        error: function(xhr, status, error) {
            console.error('Export failed:', error);
            alert('Export failed. Please try again.');
        }
    });
}

        });
    </script>
}